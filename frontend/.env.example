# Public Stellar network preset ("testnet" or "mainnet")
# NOTE: All VITE_* variables are bundled into client-side browser JavaScript.
# NEVER put secret keys (S...), mnemonics, KYC vendor API keys, or personal identity data here.
VITE_STELLAR_NETWORK=testnet

# Public Soroban contract IDs (C... addresses only)
VITE_KYC_REGISTRY_ID=
VITE_COMPLIANCE_ENGINE_ID=
VITE_INVOICE_TOKEN_ID=
VITE_PROPERTY_TOKEN_ID=
VITE_CARBON_TOKEN_ID=
VITE_RWA_TOKEN_ID=